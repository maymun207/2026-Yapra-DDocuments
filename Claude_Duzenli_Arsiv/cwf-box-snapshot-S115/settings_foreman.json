{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "ADF_LANE_ROLE": "foreman"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git merge-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git grep:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git reflog:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fsck:*)",
      "Bash(git hash-object:*)",
      "Bash(git tag --points-at:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git commit-tree:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout -b:*)",
      "Bash(git checkout --detach:*)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git -C:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api repos:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh auth status:*)",
      "Bash(gh workflow list:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(npx oxlint:*)",
      "Bash(npx playwright test:*)",
      "Bash(node -v:*)",
      "Bash(node -e:*)",
      "Bash(node --import tsx:*)",
      "Bash(python3:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(date:*)",
      "Bash(sed -n:*)",
      "Bash(ln -s:*)",
      "Bash(mkdir -p:*)",
      "Bash(chmod +x:*)",
      "Write(docs/relay/**)",
      "Edit(docs/relay/**)",
      "Write(docs/ground/**)",
      "Edit(docs/ground/**)",
      "Write(docs/laws/**)",
      "Edit(docs/laws/**)",
      "Write(docs/design/**)",
      "Edit(docs/design/**)",
      "Write(scripts/**)",
      "Edit(scripts/**)",
      "Write(api/**)",
      "Edit(api/**)",
      "Write(src/**)",
      "Edit(src/**)",
      "Write(shared/**)",
      "Edit(shared/**)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Edit(package.json)",
      "Bash(gh workflow run:*)",
      "Bash(gh run watch:*)"
    ],
    "deny": [
      "mcp__supabase-ro__apply_migration",
      "mcp__supabase-ro__create_branch",
      "mcp__supabase-ro__delete_branch",
      "mcp__supabase-ro__merge_branch",
      "mcp__supabase-ro__rebase_branch",
      "mcp__supabase-ro__reset_branch",
      "mcp__supabase-ro__deploy_edge_function"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py"
          }
        ]
      }
    ]
  }
}
