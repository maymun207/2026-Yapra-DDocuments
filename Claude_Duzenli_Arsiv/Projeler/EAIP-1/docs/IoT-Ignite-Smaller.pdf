320 @Override 
321 public void onActionReceived(String nodeId, String sensorId, 
ThingActionData thingActionData) { 
416

322 
323 } 
324 
325 /*onThingUnregistered(): Thing, IoT-Ignite ortamına kayıt edilmediğinde bu 
metot çağrılır.*/
326 @Override 
327 public void onThingUnregistered(String nodeId, String sensorId) { 
328 Log.i(TAG, "Sıcaklık sensörü kayıt edilmedi!"); 
329 /*Thing kayıt edilemediği zaman veri okumayı sağlayan task’ın 
durdurulması gerekir.*/
330 stopReadDataTask(nodeId, sensorId); 
331 } 
332 }; 
333 
334 /*Tanımladığımız lamba aktüatörünü dinlemek için ThingListener tanımladık. 
335 Bu olay dinleyicide 3 metot bulunmaktadır. Konfigürasyon ve action message 
verileri buradan alınır.*/
336 
337 private ThingListener lampThingListener = new ThingListener() { 
338 /*onConfigurationReceived(): Yapılandırma IoT-Ignite tarafından 
ayarlandığında bu metot icra edilir.*/
339 @Override 
340 public void onConfigurationReceived(Thing thing) { 
341 Log.i(TAG, "Konfigürasyon alındı " + thing.getThingID()); 
342 /*applyConfiguration: Thing bileşenlerden veri okumayı sağlayan metot 
*/
343 applyConfiguration(thing); 
344 } 
345 
346 /*onActionReceived(): Thing bir aktüatör olarak ayarlanmışsa, gönderilen 
eylem mesajları burada ele alınır. 
347 Lamb bir actuator olduğundan burada aşağıdaki işlemler yapılacaktır.*/
348 @Override 
349 public void onActionReceived(String nodeId, String sensorId, final 
ThingActionData thingActionData) { 
350 
351 Log.i(TAG, "Action Message alındı" + nodeId + " " + sensorId); 
352 
353 /*Lambanın açık ve kapalı durumu ayarlanır.*/
354 if(activity != null) { 
355 /*Main Thread yani arayüzde güncelleme yapmak için runOnUiThread 
kullanılır. Arayüz güncellemelerini doğrudan yaparsanız hata verir.*/
356 
357 activity.runOnUiThread(new Runnable() { 
358 @Override 
359 public void run() { 
360 /*MainActivity arayüzünde bulunan Lamba kontrolüne erişim 
sağlanır.*/
361 ToggleButton toggleLamp = 
activity.findViewById(R.id.toggleLamp); 
362 Log.i(TAG, thingActionData.getMessage()); 
363 int message = 0; 
364 try { 
365 /*Action Message, getMessage() ile alınır.*/
366 String s = thingActionData.getMessage(); 
367 
368 /*Mesaj null değilse*/
369 if (s != null) { 
370 /*Gelen mesaj String olduğu için bunu int tipine 
cast ederiz.*/
371 message = Integer.parseInt(s.replace("\"", "")); 
372 } 
373 } catch (NumberFormatException e) { 
374 Log.i(TAG, "Mesaj Geçersiz"); 
375 } 
376 /*Gelen mesaj 1 ise lamba yanar. Aksi durumda söner.*/
377 toggleLamp.setChecked(message == 1); 
378 } 
379 }); 
380 } 
381 } 
382 
383 /*onThingUnregistered(): Thing, IoT-Ignite ortamına kayıt edilmediğinde bu 
metot çağrılır.*/
384 @Override 
385 public void onThingUnregistered(String nodeId, String sensorId) { 
386 Log.i(TAG, "Lamp kayıt edilmedi!"); 
