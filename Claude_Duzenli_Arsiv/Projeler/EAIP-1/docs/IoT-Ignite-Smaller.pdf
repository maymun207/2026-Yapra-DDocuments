344 @Override 
345 public boolean onOptionsItemSelected(MenuItem item) { 
346 
347 for (BaseWifiNodeDevice e : espNodeList) { 
348 if (!TextUtils.isEmpty(item.getTitle()) && e.getNode() != null && !
TextUtils.isEmpty(e.getNode().getNodeID()) && 
item.getTitle().equals(e.getNode().getNodeID())) { 
349 activeEsp.removeThingEventListener(espEventListener); 
350 activeEsp = e; 
351 updateActiveEsp(); 
352 break; 
353 } 
354 } 
355 return super.onOptionsItemSelected(item); 
356 } 
