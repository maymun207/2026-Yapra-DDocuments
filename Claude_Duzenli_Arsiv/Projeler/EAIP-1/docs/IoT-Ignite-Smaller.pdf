471

ListenerService
Akıllı saatten Data Layer ile gelen nabız verisini alacak servisimiz için kodlar aşağıdaki gibidir. Bu
servis akıllı saatten nabız verilerini aldığı anda MainActivity isimli activity otomatik olarak 
başlatılır ve veri bu activity’de gösterilir.
1 package com.mas.iotignitehealth; 
2 
3 import android.content.Intent; 
4 import com.google.android.gms.wearable.DataEvent; 
5 import com.google.android.gms.wearable.DataEventBuffer; 
6 import com.google.android.gms.wearable.DataMap; 
7 import com.google.android.gms.wearable.DataMapItem; 
8 import com.google.android.gms.wearable.WearableListenerService; 
9 
10 /*WearableListenerService: Bu sınıf, veri katmanı olaylarını (data layer event) bir
11 servis içinde dinlemeyi sağlar. Servisin yaşam döngüsü sistem tarafından yönetilir.
12 Veri öğeleri ve mesajları göndermek istediğinizde servise bağlanılır, aksi durumda 
13 yani ihtiyaç olmayan durumlarda bağlantı kesilir. Servislerle çalışmak için bu 
14 sınıf kullanılır.*/
15 public class ListenerService extends WearableListenerService { 
16 
17 /* onDataChanged(): Data Layer da meydana gelen veri değişiklikleri algılayan 
18 metodumuz */
19 @Override 
20 public void onDataChanged(DataEventBuffer dataEvents) { 
21 
22 /*Akıllı saatte veri olaylarını kontrol eden döngümüz*/
23 for (DataEvent event : dataEvents) { 
24 
25 /*DataEvent.TYPE_CHANGED: Data Layer üzerinde veri değişikliği 
26 olduğunda (örneğin data layer’a yeni bir veri eklendiğinde) yapılacak 
27 işlemleri belirlemede kullanılır.*/
28 if (event.getType() == DataEvent.TYPE_CHANGED) { 
29 
30 /*Verinin path bilgisi alınır ve değişkene atanır.*/
31 String path = event.getDataItem().getUri().getPath(); 
32 
33 /*Path bilgisi /wearable_data ise, akıllı saatten metin 
34 gönderildiği anlaşılır.*/
35 if (path.equalsIgnoreCase("/wearable_data")) { 
36 
37 /*DataItem yapısında gönderilen metnimizi DataMap 
38 nesnesine atarız*/
39 DataMap dataMap = 
DataMapItem.fromDataItem(event.getDataItem()).getDataMap(); 
40 
41 /*Yeni bir intent oluşturduk. Bu intent ile MainActivity 
42 isimli activity başlatılacaktır.*/
43 Intent i = new Intent(this, MainActivity.class); 
44 
45 /*Aldığımız DataMap verisini intent içerisine ekleriz. 
46 DataMap doğrudan eklenemediğinden toBundle() metodu ile veri
47 Bundle nesnesine dönüştürülür. MainActivity isimli activity'de 
48 veriyi almak için “datamap” key değerini kullanırız.*/
49 i.putExtra("data", dataMap.toBundle()); 
50 
51 /*Activity için bayrak tanımladık. Her veri değişiminde 
52 activity yeniden başlatılır ve gelen yeni veriyi kullanıcıya 
53 gösterir FLAG_ACTIVITY_CLEAR_TASK: Çalışan bir 
54 görev varsa temizlemeyi sağlar. FLAG_ACTIVITY_NEW_ 
55 TASK: Activity'yi yeni bir görev içinde başlatır.*/
56 i.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TASK | 
Intent.FLAG_ACTIVITY_NEW_TASK); 
57 
58 /*Activity başlatılır.*/
59 startActivity(i); 
60 } 
61 
62 } 
63 } 
64 } 
65 } 
472

VirtualHumanNodeHandler
IoT-Ignite ortamında sanal sensörler oluşturabiliriz. Burada sensörleri EHUB’ta değil, Android 
kodları ile oluşturacağız. Bunun için VirtualHumanNodeHandler sınıfını geliştirdik. Bu sınıf 
özetle aşağıda verilen işlemleri yapmaktadır.
• IoT-Ignite platformuna bağlantı sağlamak ve bağlantı durumunu kontrol etmek.
• Thing oluşturup bunları IoT-Ignite ortamına kayıt etmeyi sağlamak.
• Arayüzde bulunan sanal sensörlerden gelen verileri okumak ve bu verileri IoT-Ignite 
platformuna göndermek.
Bunlar genel olarak yapılan işlemler. Ancak kodumuzu incelerseniz, daha birçok işlemin 
gerçekleştirdiğini görebilirsiniz.
Bu sınıfın kodları aşağıdaki gibi olup, her kodun açıklamasını beraberinde verdik. Bu sayede 
uygulamanın çalışma mantığını daha iyi kavrayabilirsiniz.
VirtualHumanNodeHandler
1 package com.mas.iotignitehealth; 
2 
3 import android.app.Activity; 
4 import android.content.Context; 
5 import android.util.Log; 
6 import android.widget.ImageView; 
7 import android.widget.SeekBar; 
8 import android.widget.TextView; 
9 
10 import com.ardic.android.iotignite.callbacks.ConnectionCallback; 
11 import com.ardic.android.iotignite.enumerations.NodeType; 
12 import com.ardic.android.iotignite.enumerations.ThingCategory; 
13 import com.ardic.android.iotignite.enumerations.ThingDataType; 
14 import com.ardic.android.iotignite.exceptions.AuthenticationException; 
15 import com.ardic.android.iotignite.exceptions.UnsupportedVersionException; 
16 import com.ardic.android.iotignite.listeners.NodeListener; 
17 import com.ardic.android.iotignite.listeners.ThingListener; 
18 import com.ardic.android.iotignite.nodes.IotIgniteManager; 
19 import com.ardic.android.iotignite.nodes.Node; 
20 import com.ardic.android.iotignite.things.Thing; 
21 import com.ardic.android.iotignite.things.ThingActionData; 
22 import com.ardic.android.iotignite.things.ThingConfiguration; 
23 import com.ardic.android.iotignite.things.ThingData; 
24 import com.ardic.android.iotignite.things.ThingType; 
25 
26 import java.util.Hashtable; 
27 import java.util.Timer; 
28 import java.util.TimerTask; 
29 import java.util.concurrent.Executors; 
30 import java.util.concurrent.ScheduledExecutorService; 
31 import java.util.concurrent.ScheduledFuture; 
32 import java.util.concurrent.TimeUnit; 
33 
34 /*VirtualHumanNodeHandler bu sınıf özetle 
35 IOTIGNITE PLATFORMUNA BAĞLANTI, 
36 THING OLUŞTURMA VE IOT-IGNITE PLATFORMUNA KAYIT ETMEK, 
37 MAINACTIVITY ARAYÜZÜNDE BULUNAN SENSÖR VERİLERİNİ OKUMAK VEYA OKUMAYI İPTAL ETMEK, 
38 SENSÖR VERİLERİNİ IOT-IGNITE ORTAMINA GÖNDERMEK ve daha birçok 
39 işlemi yapmak için kullanılmaktadır.*/
40 
41 /*onConnected() ve onDisconnected() metotlarını eklemek için 
42 sınıfa ConnectionCallback arayüzü uygulanmalıdır.*/
43 public class VirtualHumanNodeHandler implements ConnectionCallback { 
44 
45 /********DEĞİŞKENLER********/
46 
47 /*Uygulama içinde kullanacağımız değişkenlerimiz*/
48 private static final String TAG = "Health App"; 
49 
50 /*ScheduledExecutorService: Komutları belirli bir gecikmeden sonra çalıştırmayı
veya periyodik olarak yürütmeyi sağlar.*/
473

51 private static volatile ScheduledExecutorService mExecutor; 
52 
53 /*İş parçacığı havuzunda tutulacak iş parçacığı sayısı 2 tane olacaktır.*/
54 private static final int NUMBER_OF_THREADS_IN_EXECUTOR = 2; 
55 
56 /*EXECUTOR_START_DELAY: iş parçası için gecikme süresi tanımladık*/
57 private static final long EXECUTOR_START_DELAY = 100L; 
58 
59 /*Thing bileşenlerden veri okumayaı sağlayan bir görev tanımladık. 
60 Hashtable: Bu sınıf, key-value çiftlerinden oluşan bir karma tablo oluşturmayı 
sağlar.*/
61 private Hashtable<String, ScheduledFuture<?>> tasks = new Hashtable<>(); 
62 
63 /*IotIgniteManager: IoT-Ignite pltaformuna bağlanmayı sağlayan temel 
sınıftır.*/
64 private static IotIgniteManager mIotIgniteManager; 
65 
66 /*Sanal node oluşturmak için Node sınıfı kullanılır.*/
67 private Node mNode; 
68 
69 /*Sanal Thing oluşturmak için Thing sınıfı kullanılır.*/
70 private Thing mRateThing; 
71 
72 /*ThingType: Sensörün türünü belirtir. Sensör tipi ve üretici hakkında bilgi 
depolamayı sağlar.*/
73 private ThingType mRateThingType; 
74 
75 /*ThingDataHandler: Thing verilerini Ignite ortamına göndermeyi sağlayan iş 
parçacığı.*/
76 private ThingDataHandler mThingDataHandler; 
77 
78 /*IoT-Ignite ortamına bağlantı durumunu tutan bir değişken tanımladık*/
79 private boolean igniteConnected = false; 
80 
81 /*Bağlantı işlemini kontrol etmek için oluşturulan görevin bekleme süresi*/
82 private static final long IGNITE_TIMER_PERIOD = 5000L; 
83 
84 /*Timer: Bir iş parçacığını gelecekte yürütmek için kullanılır.*/
85 private Timer igniteTimer = new Timer(); 
86 
87 /*IgniteWatchDog İş parçacığı ile Ignite bağlantısı kontrol edilir.*/
88 private IgniteWatchDog igniteWatchDog = new IgniteWatchDog(); 
89 
90 private Context ctx; 
91 private Activity activity; 
92 
93 /********KURUCU METODUMUZ********/
94 public VirtualHumanNodeHandler(Activity activity) { 
95 this.ctx = activity.getApplicationContext(); 
96 this.activity = activity; 
97 } 
98 
99 
100 /********IOT-IGNITE PLATFORMUNA BAĞLANTI ********/
101 /*IgniteWatchDog İş parçacığı ile Ignite bağlantısı kontrol edilir. 
102 Bunun için sınıfın TimerTask sınıfından türetilmesi gerekiyor. 
103 TimerTask sınıfı bir defalık veya tekrarlanan görevlerin yürütülmesi 
sağlanır.*/
104 private class IgniteWatchDog extends TimerTask { 
105 @Override 
106 public void run() { 
107 /*IoT-Ignite platformuna bağlantı yoksa bağlantı işlemi yapılmaya 
çalışılır.*/
108 if (!igniteConnected) { 
109 Log.i(TAG, "Ignite bağlantısı kuruluyor..."); 
110 /*start metodu ile bağlantı sağlanır.*/
111 start(); 
112 } 
113 } 
114 } 
115 
116 /*Ignite platformuna bağlanmayı sağlayan metodumuz.*/
117 public void start() { 
118 
119 try { 
120 /*IotIgniteManager.Builder: IgniteManger oluşturulur. 
121 Bu sınıf IoT-Ignite platformuna bağlanmayı sağlar. 
122 setContext(): Bağlantı işleminin hangi uygulama için yapılacağı 
474

123 belirtilir. Buraya parametre olarak Context verilir. 
124 setConnectionListener: Parametre olarak ConnectionCallback arayüzü 
125 alır. Bağlantı sağlandığı zaman bu arayüz ile gelen onConnected() 
126 metodu çağrılır. Bu arayüzü VirtualHumanNodeHandler sınıfına yukarıda 
127 uygulamıştık. build(): bu metot ile bağlantı işlemi sağlanır.*/ 
128 mIotIgniteManager = new IotIgniteManager.Builder() 
129 .setContext(ctx) 
130 .setConnectionListener(this) 
131 .build(); 
132 
133 } catch (UnsupportedVersionException e) { 
134 Log.e(TAG, e.toString()); 
135 
136 } 
137 /*Bağlantı sağlandıktan sonra Timer durdurulur.*/
138 cancelAndScheduleIgniteTimer(); 
139 } 
140 
141 /*cancelAndScheduleIgniteTimer: Ignite platformuna bağlantı sağlandıktan sonra 
Timer sonlandırılır.*/
142 private void cancelAndScheduleIgniteTimer() { 
143 /*cancel: Planlanmış görevleri iptal ederek Timer nesnesini sonlandırır.*/
144 igniteTimer.cancel(); 
145 igniteWatchDog.cancel(); 
146 
147 /*Timer nesneleri yeniden oluşturulur.*/
148 igniteWatchDog = new IgniteWatchDog(); 
149 igniteTimer = new Timer(); 
150 
151 /*schedule(): igniteWatchDog iş parçası 500 milisaniye sonra tekrar 
başlatılır.*/
152 igniteTimer.schedule(igniteWatchDog, IGNITE_TIMER_PERIOD); 
153 } 
154 
155 public void stop() { 
156 if (igniteConnected) { 
157 /*IoT-Ignite ile bağlantı kesildiği zaman Node ve Thing bileşenleri 
158 çevrimdışı yapmak için setConnected() metodunu kullanırız. 
159 Bu metot bağlantı durumunu ayarlamayı sağlar. Metodun ikinci 
160 parametresine istediğiniz değeri verebilirsiniz.*/
161 mRateThing.setConnected(false, "Application Destroyed"); 
162 mNode.setConnected(false, "ApplicationDestroyed"); 
163 } 
164 /*mExecutor null ise sonlandırılır.*/
165 if (mExecutor != null) { 
166 mExecutor.shutdown(); 
167 } 
168 } 
169 
170 /*onConnected() ve onDisconnected() metotları ConnectionCallback arayüzü ile 
171 gelen metotlardır. 
172 IoT-Ignite platformuna bağlantı sağlanırsa onConnected() metodu çağrılır.*/
173 @Override 
174 public void onConnected() { 
175 
176 Log.i(TAG, "Ignite Bağlantısı Kuruldu!"); 
177 igniteConnected = true; 
178 
179 /*Bağlantı durumu aşağıdaki metot ile kullanıcı arayüzüne uygulanır.*/
180 updateConnectionStatus(true); 
181 
182 /*Ignite platformuna bağlantı sağlanırsa aşağıdaki metotlar icra edilir.*/
183 /*Node ve Thing oluşturulup ignite platformuna kayıt edilir. Ayrıca Thing 
184 bileşenlere ilk değerleri atanır.*/
185 initIgniteVariables(); 
186 sendInitialData(); 
187 cancelAndScheduleIgniteTimer(); 
188 } 
189 
190 /*IoT-Ignite platformuna bağlantı kurulamaz ise onDisconnected() metodu 
çağrılır.*/
191 @Override 
192 public void onDisconnected() { 
193 Log.i(TAG, "Ignite Bağlantısı Kesildi!"); 
194 igniteConnected = false; 
195 /*Bağlantı durumu aşağıdaki metot ile kullanıcı arayüzüne uygulanır.*/
196 updateConnectionStatus(false); 
197 cancelAndScheduleIgniteTimer(); 
475

198 } 
