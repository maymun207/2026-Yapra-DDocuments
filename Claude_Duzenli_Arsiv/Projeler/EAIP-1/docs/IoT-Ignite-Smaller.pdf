200 /*IoT-Ignite platformu ile bağlantının olup olmadığını 
201 MainActivity'de göstermek için bu metot kullanılır. 
202 Amaç kullanıcıya bağlantı durumu hakkında bilgi vermektir.*/
203 private void updateConnectionStatus(final boolean connected) { 
204 if (activity != null) { 
205 /*runOnUiThread(): Main Thread üzerinde değişiklik yapmak için bir 
206 Runnable tanımlar. Runnable ile arayüz güncellenir.*/
207 activity.runOnUiThread(new Runnable() { 
208 @Override 
209 public void run() { 
210 /*MainActivity arayüzünde bulunan iki kontrole erişim 
sağlanır.*/
211 ImageView imageViewConnection = 
activity.findViewById(R.id.imageViewConnection); 
212 TextView textViewConnection = 
activity.findViewById(R.id.textConnection); 
213 
214 /*connected true ise kullanıcı arayüzünde bağlantının kurulduğu
215 false ise bağlantının kurulamadığı bilgisi verilir.*/
216 if (connected) { 
217 imageViewConnection.setImageDrawable(activity.getResources().getDrawable(R.drawable.conn
ected)); 
218 textViewConnection.setText("Bağlandı"); 
219 } else { 
220 imageViewConnection.setImageDrawable(activity.getResources().getDrawable(R.drawable.disc
onnected)); 
221 textViewConnection.setText("Bağlanamadı"); 
222 } 
223 } 
224 }); 
225 } 
226 } 
